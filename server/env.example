# Omgevingsvariabelen voor de rotatiebot. Kopie staat in /etc/rotatiebot/env (chmod 600).

# droog = alleen laten zien wat hij zou doen (ook op paper), echt = orders plaatsen
MODUS=droog

# 4002 = paper trading, 4001 = echt geld (moet overeenkomen met OverrideTwsApiPort in ibc-config.ini)
IB_PORT=4002
IB_HOST=127.0.0.1
IB_CLIENT_ID=7

# Telegram: maak een bot via @BotFather (token) en stuur hem een bericht; chat-id via @userinfobot
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Optioneel: rapport ook per e-mail (bv. Microsoft 365: smtp.office365.com, poort 587)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_TO=

# Minimaal orderbedrag in euro; kleinere verschillen worden niet bijgehandeld
DREMPEL_EUR=25
# Fractie cash die buiten de allocatie blijft voor kosten en afronding
CASH_BUFFER=0.01
# Hoe lang wachten op goedkeuring van de 2FA-melding (seconden)
WACHT_LOGIN_SEC=1200
